{
 "slug": "shipping-plan",
 "title": "선적 — 선적 계획 묶기·선적요청·내 선적묶음·취소",
 "login": {
  "email": "board-check@local.test"
 },
 "viewport": "pc",
 "needs": [
  "erp",
  "erp-reset"
 ],
 "allowClicks": [
  "conclude",
  "syncBundles",
  "cancelBundle"
 ],
 "steps": [
  {
   "goto": "/listings"
  },
  {
   "clickText": "매입예정 추가",
   "in": "button"
  },
  {
   "wait": 1000
  },
  {
   "clickText": "셀프검차매입",
   "in": "button"
  },
  {
   "wait": 600
  },
  {
   "set": "input@model(expected_price)",
   "value": "9800000"
  },
  {
   "set": "input@model(vehicle_number)",
   "value": "30가3009"
  },
  {
   "set": "input@model(owner_name)",
   "value": "점검차주"
  },
  {
   "set": "input[placeholder^='수원']",
   "value": "경기 수원시"
  },
  {
   "wait": 800
  },
  {
   "clickText": "저장",
   "in": "button[wire\\:click=\"save\"]"
  },
  {
   "wait": 2500
  },
  {
   "check": "준비 — 셀프검차매입 등록(구매대기)",
   "db": "select status, origin from purchase_listings where vehicle_number = ? and deleted_at is null and created_at >= ?",
   "args": [
    "30가3009",
    "{since}"
   ],
   "expect": {
    "status": "accepted",
    "origin": "self_inspection"
   }
  },
  {
   "goto": "/auction"
  },
  {
   "clickText": "30가3009",
   "in": "td, tr"
  },
  {
   "wait": 1500
  },
  {
   "set": "input@model(car_cost)",
   "value": "9800000"
  },
  {
   "set": "input@model(sale_total)",
   "value": "9300"
  },
  {
   "click": "input[type=radio][value=USD]"
  },
  {
   "set": "input@model(rate_usd)",
   "value": "1400"
  },
  {
   "select": "select@model(buyerId)",
   "text": "BOARD CHECK TRADING 2"
  },
  {
   "wait": 1500
  },
  {
   "upload": "input@model(salesFiles)",
   "files": [
    "board-check-doc.pdf"
   ],
   "after": 2000
  },
  {
   "clickText": "구매확정",
   "in": "button.btn-green"
  },
  {
   "wait": 2000
  },
  {
   "check": "준비 — 첫 클릭 = 첨부 저장·정보 찾기 대기",
   "text": "첨부사진에서 정보를 찾는 중입니다"
  },
  {
   "check": "준비 — 첨부는 서류·추출은 사진 없음(GPU 안 부름)",
   "db": "select i.kind, l.payee_extraction_status from inspection_photos i join purchase_listings l on l.id = i.purchase_listing_id where l.vehicle_number = ? and l.deleted_at is null",
   "args": [
    "30가3009"
   ],
   "expect": {
    "kind": "sales_document",
    "payee_extraction_status": "none"
   }
  },
  {
   "clickText": "구매확정",
   "in": "button.btn-green"
  },
  {
   "wait": 4000
  },
  {
   "check": "준비 — 구매확정 처리 안내",
   "text": "처리되었습니다"
  },
  {
   "check": "준비 — ERP 로 넘어감(synced)",
   "db": "select status, car_erp_vehicle_id, offer_currency from purchase_listings where vehicle_number = ? and deleted_at is null",
   "args": [
    "30가3009"
   ],
   "expect": {
    "status": "synced",
    "car_erp_vehicle_id": "*",
    "offer_currency": "USD"
   }
  },
  {
   "goto": "/portal"
  },
  {
   "wait": 1500
  },
  {
   "check": "메뉴 「내 정산·미수 (포털)」",
   "text": "내 정산·미수 (포털)"
  },
  {
   "clickText": "선적요청",
   "in": "button.rounded-md"
  },
  {
   "wait": 3000
  },
  {
   "clickText": "선적 계획",
   "in": "button"
  },
  {
   "wait": 3000
  },
  {
   "check": "[선적 계획] — 아직 선적요청 전인 차",
   "text": "아직 선적요청 전인 차"
  },
  {
   "check": "위쪽 [선적요청] 버튼",
   "text": "🔄 선적요청"
  },
  {
   "clickText": "BOARD CHECK TRADING 2",
   "in": "button"
  },
  {
   "wait": 1000
  },
  {
   "check": "바이어 펼침 — 내 차 후보",
   "text": "30가3009"
  },
  {
   "check": "차 옆 「미수 N%」",
   "text": "미수 100%"
  },
  {
   "check": "RORO / CONTAINER",
   "text": "CONTAINER"
  },
  {
   "check": "B/L 미정",
   "text": "미정"
  },
  {
   "clickText": "30가3009",
   "in": "label"
  },
  {
   "wait": 1500
  },
  {
   "select": "select[wire\\:change*='forwarding_company_id']",
   "without": "🔒"
  },
  {
   "wait": 1200
  },
  {
   "click": "button[wire\\:click=\"syncBundles\"]"
  },
  {
   "wait": 4000
  },
  {
   "check": "「선적요청 완료!」",
   "text": "선적요청 완료!"
  },
  {
   "check": "「생성 N 갱신 N」",
   "text": "생성 1"
  },
  {
   "check": "선적요청 기록(감사 행)",
   "db": "select count(*) as n from board_audit_logs where action = 'erp_shipping_sync' and created_at >= ? and new_value like ? and new_value like '%\"result\":\"ok\"%'",
   "args": [
    "{since}",
    "%30가3009%"
   ],
   "expect": {
    "n": 1
   }
  },
  {
   "clickText": "내 선적묶음",
   "in": "button"
  },
  {
   "wait": 3000
  },
  {
   "check": "[내 선적묶음] 「요청됨」",
   "text": "요청됨"
  },
  {
   "check": "묶음에 내 차",
   "text": "30가3009"
  },
  {
   "check": "선적 서류 「RORO Contract」",
   "text": "RORO Contract"
  },
  {
   "check": "선적 서류 「RORO Invoice&Packing」",
   "text": "RORO Invoice&Packing"
  },
  {
   "check": "바이어 서류 「판매계약서」",
   "text": "판매계약서"
  },
  {
   "check": "바이어 서류 「Proforma Invoice」",
   "text": "Proforma Invoice"
  },
  {
   "check": "[전자서명 요청] 버튼(누르지 않음)",
   "text": "전자서명 요청"
  },
  {
   "clickText": "선적 취소",
   "in": "button"
  },
  {
   "wait": 4000
  },
  {
   "check": "[선적 취소] → 「취소 1」",
   "text": "취소 1"
  },
  {
   "check": "요청된 묶음 안 남음",
   "noText": "✕ 선적 취소"
  },
  {
   "check": "선적요청·취소 둘 다 ERP 2xx",
   "db": "select count(*) as n from integration_events where event_type = 'shipping_sync' and created_at >= ? and response_status between 200 and 299 and request_payload like '%board-check@local.test%'",
   "args": [
    "{since}"
   ],
   "expect": {
    "n": 2
   }
  },
  {
   "check": "취소도 감사 행",
   "db": "select count(*) as n from board_audit_logs where action = 'erp_shipping_sync' and created_at >= ? and user_id = (select id from users where email = 'board-check@local.test') and new_value like '%\"result\":\"ok\"%'",
   "args": [
    "{since}"
   ],
   "expect": {
    "n": 2
   }
  }
 ]
}
