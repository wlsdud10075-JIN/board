  {"check":"8단계 — 이 회차 반영 기록","db":"select erp_sent_revision, erp_claim_id is not null as has_erp_id, erp_send_error from claims where vehicle_number = ? and created_at >= ?","args":["30가3014","{since}"],"expect":{"erp_sent_revision":1,"has_erp_id":1,"erp_send_error":null}},
  {"check":"8단계 — ERP 전송 기록(승인·확정 금액만)","db":"select count(*) as n, max(e.response_status) as http, max(e.error) as err, max(json_unquote(json_extract(e.request_payload, '$.result'))) as result, max(json_extract(e.request_payload, '$.confirmed_amount')) as amount from integration_events e join claims c on json_extract(e.request_payload, '$.board_claim_id') = c.id where e.event_type = 'claim_mirror' and c.vehicle_number = ? and e.created_at >= ?","args":["30가3014","{since}"],"expect":{"n":1,"err":null,"result":"accepted","amount":"230"}}
 ]}
